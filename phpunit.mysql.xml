<?xml version="1.0" encoding="UTF-8"?>
<!--
    Isolated MySQL 8 / InnoDB PHPUnit Configuration
    PREFLIGHT SAFETY PROCEDURE:
    1. Provision a dedicated, empty MySQL 8 database whose name strictly ends with "_test"
       (e.g. auraluxe_staging_test). NEVER point this configuration at a staging or production DB.
    2. Supply credentials via shell environment variables (DB_HOST, DB_PORT, DB_USERNAME, DB_PASSWORD)
       or a local gitignored .env.testing file. Do NOT commit credentials to this file.
    3. RefreshDatabase executes migrate:fresh (destructive) during test execution.
       TestCase::setUpTraits() aborts execution if a non-SQLite database lacks the "_test" suffix.
    Usage: php artisan test -c phpunit.mysql.xml
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_DEBUG" value="false"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="auraluxe_staging_test"/>
        <env name="DB_ENGINE" value="InnoDB"/>
        <env name="DB_CHARSET" value="utf8mb4"/>
        <env name="DB_COLLATION" value="utf8mb4_unicode_ci"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>

